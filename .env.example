# Copy this file to .env for local development and replace credentials before
# exposing the stack outside a trusted development machine.
COMPOSE_PROJECT_NAME=apanel
APP_ENV=development
HTTP_PORT=8080

POSTGRES_DB=apanel
POSTGRES_USER=apanel
# Keep the password URL-safe because DATABASE_URL is assembled by Compose.
POSTGRES_PASSWORD=replace_with_a_long_url_safe_random_password

# Backend authentication only: use a unique random value of at least 32 bytes outside local development.
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret_at_least_32_bytes
JWT_ISSUER=apanel
JWT_AUDIENCE=apanel-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
INVITATION_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=refresh_token
# Set true when APP_ENV=production and serve the site over HTTPS.
REFRESH_COOKIE_SECURE=false

HEALTH_PROBE_TIMEOUT_SECONDS=2
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_COMMAND_TIMEOUT_SECONDS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
NODE_ENV=production
