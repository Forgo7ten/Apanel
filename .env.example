# 项目名称；Compose 使用此值作为默认项目名，部署到共享环境时应确保名称唯一。
COMPOSE_PROJECT_NAME=apanel
# 应用运行环境；可选 development（本地开发）、test（测试）或 production（生产）。
APP_ENV=development
# 对外暴露的 HTTP 端口；必须是有效且未被占用的本机 TCP 端口。
HTTP_PORT=8080

# 镜像构建网络模式；可选 host（使用宿主机网络，适合当前 Linux 开发环境）或 default（使用 Docker 默认构建网络）。
DOCKER_BUILD_NETWORK=host
# Python 包索引镜像地址；留空时不修改 pip 配置并使用 pip 默认源，默认使用清华 PyPI 镜像。
PYPI_MIRROR_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# PostgreSQL 数据库名称；默认使用 apanel，必须是有效的数据库标识符。
POSTGRES_DB=apanel
# PostgreSQL 数据库用户；默认使用 apanel，必须与数据库初始化配置一致。
POSTGRES_USER=apanel
# PostgreSQL 密码；必须替换为随机强密码，并保持 URL 安全以便 Compose 拼接 DATABASE_URL。
POSTGRES_PASSWORD=replace_with_a_long_url_safe_random_password

# 后端 JWT 签名密钥；本地开发可用占位值，其他环境必须使用唯一且至少 32 字节的随机密钥。
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret_at_least_32_bytes
# JWT 签发者标识；默认值为 apanel，客户端验证时必须保持一致。
JWT_ISSUER=apanel
# JWT 受众标识；默认值为 apanel-web，客户端验证时必须保持一致。
JWT_AUDIENCE=apanel-web
# 访问令牌有效期；默认 900 秒，必须填写正整数秒数。
ACCESS_TOKEN_TTL_SECONDS=900
# 刷新令牌有效期；默认 2592000 秒，必须填写正整数秒数。
REFRESH_TOKEN_TTL_SECONDS=2592000
# 邀请链接有效期；默认 604800 秒，必须填写正整数秒数。
INVITATION_TTL_SECONDS=604800
# 刷新令牌 Cookie 名称；默认 refresh_token，应使用合法且稳定的 Cookie 名称。
REFRESH_COOKIE_NAME=refresh_token
# 刷新令牌 Cookie 的 Secure 标志；可选 true（仅 HTTPS 发送）或 false（允许 HTTP，本地开发默认）。
REFRESH_COOKIE_SECURE=false

# 健康检查超时时间；默认 2 秒，必须填写正整数秒数。
HEALTH_PROBE_TIMEOUT_SECONDS=2
# 数据库连接超时时间；默认 5 秒，必须填写正整数秒数。
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# 数据库命令超时时间；默认 5 秒，必须填写正整数秒数。
DATABASE_COMMAND_TIMEOUT_SECONDS=5
# Redis Socket 连接超时时间；默认 5 秒，必须填写正整数秒数。
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
# Redis Socket 操作超时时间；默认 5 秒，必须填写正整数秒数。
REDIS_SOCKET_TIMEOUT_SECONDS=5

# 行情数据中心使用 eltdx 作为 TDX 实现，AKShare 仅作为证券主数据回退提供方。
# 留空 ELTDX_HOSTS 可使用 eltdx 内置的主机列表和排序。
# eltdx 服务地址列表；默认留空，多个地址按 eltdx 支持的格式配置。
ELTDX_HOSTS=
# eltdx 请求超时时间；默认 5 秒，必须填写正数秒数。
ELTDX_TIMEOUT_SECONDS=5
# 是否探测并排序 eltdx 主机；默认 true，仅接受 true 或 false。
ELTDX_PROBE_HOSTS=true
# eltdx 心跳间隔；默认 30 秒，必须填写正数秒数。
ELTDX_HEARTBEAT_INTERVAL_SECONDS=30
# eltdx 每页行情数据条数；默认 800，必须填写正整数。
ELTDX_BAR_PAGE_SIZE=800
# eltdx 行情数据最大分页数；默认 64，必须填写正整数。
ELTDX_BAR_MAX_PAGES=64
# 证券主数据回退提供方；可选 akshare（启用回退）或 none/disabled/off/false（关闭回退）。
SECURITY_MASTER_FALLBACK_PROVIDER=akshare
# AKShare 证券主数据请求超时时间；默认 90 秒，必须填写正数秒数。
AKSHARE_SECURITY_TIMEOUT_SECONDS=90
# AKShare 最低股票数量阈值；默认 1000，必须填写正整数。
AKSHARE_MIN_STOCK_COUNT=1000
# AKShare 最低 ETF 数量阈值；默认 1，必须填写正整数。
AKSHARE_MIN_ETF_COUNT=1
# 内部服务认证令牌；生产环境必须替换为唯一随机值，且不得提交真实密钥。
INTERNAL_API_TOKEN=replace_with_a_long_random_internal_api_token

# 一次性证券元数据初始化总超时时间；Compose 启动时执行并在提供方失败时重试，必须为正数秒数。
SECURITY_BOOTSTRAP_TIMEOUT_SECONDS=180
# 证券元数据初始化重试间隔；默认 30 秒，必须为正数秒数。
SECURITY_BOOTSTRAP_RETRY_INTERVAL_SECONDS=30

# 调度器行情刷新范围为 5—10 分钟；日终任务在 A 股收盘后运行，Celery 时间均使用 Asia/Shanghai。
# market-data-hub 的内部服务地址；必须是可从调度器容器访问的 HTTP URL。
MARKET_DATA_HUB_URL=http://market-data-hub:8001
# 行情刷新间隔；默认 5 分钟，按约束必须为 5 到 10 的整数。
QUOTE_REFRESH_INTERVAL_MINUTES=5
# 日终任务小时；默认上海时间 15 点，必须填写 0—23 的整数。
EOD_PIPELINE_HOUR=15
# 日终任务分钟；默认上海时间 20 分，必须填写 0—59 的整数。
EOD_PIPELINE_MINUTE=20
# 调度器锁有效期；默认 3600 秒，必须填写正整数秒数。
SCHEDULER_LOCK_TTL_SECONDS=3600
# 调度器最大重试次数；默认 3 次，必须填写非负整数。
SCHEDULER_RETRY_MAX_ATTEMPTS=3
# 调度器重试退避时间；默认 60 秒，必须填写非负整数秒数。
SCHEDULER_RETRY_BACKOFF_SECONDS=60
# Node.js 运行环境；可选 development（开发）、test（测试）或 production（生产）。
NODE_ENV=production

# 分析初始化及行情数据中心批处理配置。
# eltdx 行情批量请求大小；默认 50，必须填写正整数。
ELTDX_QUOTE_BATCH_SIZE=50
# 行情数据同步并发数；默认 4，必须填写正整数并结合资源限制调整。
MARKET_DATA_SYNC_CONCURRENCY=4
# 单次请求允许同步的最大股票数；默认 100，必须填写正整数。
MARKET_DATA_SYNC_MAX_SYMBOLS_PER_REQUEST=100
# 行情数据同步批次大小；默认 50，必须填写正整数。
MARKET_DATA_SYNC_BATCH_SIZE=50
# 行情数据请求超时时间；默认 15 秒，必须填写正数秒数。
MARKET_DATA_QUOTE_TIMEOUT_SECONDS=15
# 日线数据请求超时时间；默认 60 秒，必须填写正数秒数。
MARKET_DATA_DAILY_TIMEOUT_SECONDS=60
# 行情数据初始化超时时间；默认 120 秒，必须填写正数秒数。
MARKET_DATA_BOOTSTRAP_TIMEOUT_SECONDS=120
# 分析初始化所需的最少 K 线数量；默认 400，必须填写正整数。
ANALYSIS_BOOTSTRAP_MIN_BARS=400
# 是否启用无分析结果模式；默认 true，仅接受 true 或 false。
ENABLE_NONE_ANALYSIS=true

# 通知安全配置；生产环境的密钥应为 URL 安全的 Base64 编码 32 字节随机值。
# 飞书 Webhook 允许访问的主机列表；默认允许官方域名，多个主机用逗号分隔。
FEISHU_WEBHOOK_ALLOWED_HOSTS=open.feishu.cn,open.larksuite.com
# 应用机密加密密钥；生产环境必须配置唯一随机密钥，留空表示未配置。
APP_SECRETS_KEY=
# 应用机密密钥版本；默认 v1，用于密钥轮换时区分版本。
APP_SECRETS_KEY_VERSION=v1
# 是否允许旧版 Webhook 回退；默认 true，仅接受 true 或 false，生产环境应按迁移状态评估。
LEGACY_WEBHOOK_FALLBACK_ENABLED=true
