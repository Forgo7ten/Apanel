# Copy this file to .env for local development and replace credentials before
# exposing the stack outside a trusted development machine.
COMPOSE_PROJECT_NAME=apanel
APP_ENV=development
HTTP_PORT=8080

POSTGRES_DB=apanel
POSTGRES_USER=apanel
# Keep the password URL-safe because DATABASE_URL is assembled by Compose.
POSTGRES_PASSWORD=replace_with_a_long_url_safe_random_password

# Backend authentication only: use a unique random value of at least 32 bytes outside local development.
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret_at_least_32_bytes
JWT_ISSUER=apanel
JWT_AUDIENCE=apanel-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
INVITATION_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=refresh_token
# Set true when APP_ENV=production and serve the site over HTTPS.
REFRESH_COOKIE_SECURE=false

HEALTH_PROBE_TIMEOUT_SECONDS=2
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_COMMAND_TIMEOUT_SECONDS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5

# Market Data Service: service-to-service token; never expose this to frontend.
MARKET_DATA_PROVIDER=tdx
PROVIDER_TIMEOUT_SECONDS=5
SECURITY_MASTER_FALLBACK_PROVIDER=akshare
AKSHARE_SECURITY_TIMEOUT_SECONDS=90
AKSHARE_MIN_STOCK_COUNT=1000
AKSHARE_MIN_ETF_COUNT=1
TDX_SERVERS=119.147.212.81:7709,101.227.73.20:7709
TDX_CONNECT_TIMEOUT_SECONDS=5
TDX_RETRY_ATTEMPTS=1
TDX_SYMBOL_TIMEOUT_SECONDS=60
TDX_SYMBOL_MAX_PAGES=100
TDX_BAR_PAGE_SIZE=800
TDX_BAR_MAX_PAGES=64
INTERNAL_API_TOKEN=replace_with_a_long_random_internal_api_token
# One-shot security metadata bootstrap starts with Compose and retries provider
# failures without printing this token. Values are seconds and must be positive.
# Covers TDX symbols (60s) + one complete AKShare fallback batch (90s) +
# bounded worker shutdown (5s) and HTTP overhead.
SECURITY_BOOTSTRAP_TIMEOUT_SECONDS=180
SECURITY_BOOTSTRAP_RETRY_INTERVAL_SECONDS=30

# Scheduler: quote refresh is constrained to 5-10 minutes. EOD runs after
# the A-share close; all times use Asia/Shanghai in Celery.
MARKET_DATA_SERVICE_URL=http://market-data-service:8001
QUOTE_REFRESH_INTERVAL_MINUTES=5
EOD_PIPELINE_HOUR=15
EOD_PIPELINE_MINUTE=20
SCHEDULER_LOCK_TTL_SECONDS=3600
SCHEDULER_RETRY_MAX_ATTEMPTS=3
SCHEDULER_RETRY_BACKOFF_SECONDS=60
NODE_ENV=production
